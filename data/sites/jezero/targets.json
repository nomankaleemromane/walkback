{
 "objectives": [
  {
   "id": "A",
   "name": "Delta sediments",
   "goal": "Sample the western delta's layered fine-grained sediments, the rocks most likely to preserve organic matter and signs of ancient life."
  },
  {
   "id": "B",
   "name": "Margin carbonates",
   "goal": "Reach the carbonate-bearing margin unit to study how the lake shoreline and water chemistry changed."
  },
  {
   "id": "C",
   "name": "Crater-floor igneous rocks",
   "goal": "Examine the olivine-rich Seitah unit and the Maaz floor to date the crater floor and its alteration by water."
  }
 ],
